# Copy to /etc/cloudflared/config.yml and replace <TUNNEL_ID>.
# The credentials JSON is a secret: it lives in /etc/cloudflared, never in git.
tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  # Stable Docker build (deploy/compose.yml)
  - hostname: wine.bobsabayesian.io
    service: http://localhost:3000
  # Working copy: pnpm --filter web dev -- -p 3001
  # Protect this one with Cloudflare Access.
  - hostname: wine-dev.bobsabayesian.io
    service: http://localhost:3001
  - service: http_status:404
