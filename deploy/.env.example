# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin(s) the web UI is reached at, comma-separated. Passed to the backend as CORS.
PUBLIC_ORIGIN=https://wine.bobsabayesian.io

# Host port for the web UI (bound to 127.0.0.1 only). Dev server uses 3001.
WEB_PORT=3000

# Google Gemini API key for looking up wine scores, reviews and details
# (https://aistudio.google.com/apikey). Leave empty to turn the lookup off.
GEMINI_API_KEY=
